// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "command": "bun run watch",
            "label": "bun: watch",
            // `bun run watch` 用 concurrently 并行跑扩展与 Webview 两条监听构建，
            // 输出带 `[extension]` / `[webview]` 前缀且都含 `built in`，因此
            // 「任一条首次完成」就会判定任务就绪。扩展构建只有几十毫秒、几乎总在
            // 前面，抢跑窗口可以忽略。
            "problemMatcher": {
                "owner": "vite",
                "pattern": [],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "build started|building",
                    "endsPattern": "built in"
                }
            },
            "isBackground": true,
            "presentation": {
                // 后台常驻，不抢占终端面板；构建报错仍可在「终端 → 任务」里翻到。
                "reveal": "never"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "command": "bun run test",
            "label": "bun: test",
            "problemMatcher": [],
            "group": "test"
        },
        {
            "type": "shell",
            "command": "bun run test:coverage",
            "label": "bun: test:coverage",
            "problemMatcher": [],
            "group": "test"
        }
    ]
}
