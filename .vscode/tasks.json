// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "npm",
            "script": "watch",
            "label": "npm: watch",
            // `pnpm watch` 并行跑扩展与 Webview 两条监听构建，二者的输出都带
            // `built in`，因此「任一条首次完成」就会判定任务就绪。扩展构建只有
            // 几十毫秒、几乎总在前面，抢跑窗口可以忽略。
            "problemMatcher": {
                "owner": "vite",
                "pattern": [],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "build started|building",
                    "endsPattern": "built in"
                }
            },
            "isBackground": true,
            "presentation": {
                // 后台常驻，不抢占终端面板；构建报错仍可在「终端 → 任务」里翻到。
                "reveal": "never"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "npm",
            "script": "test",
            "label": "npm: test",
            "problemMatcher": [],
            "group": "test"
        },
        {
            "type": "npm",
            "script": "test:coverage",
            "label": "npm: test:coverage",
            "problemMatcher": [],
            "group": "test"
        }
    ]
}
