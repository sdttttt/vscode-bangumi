{
    "name": "bangumiopen",
    "publisher": "SDTTTTT",
    "author": "SDTTTTT",
    "repository": "https://github.com/sdttttt/vscode-Bangumi",
    "displayName": "Bangumi Open",
    "description": "Support bilibili bangumi for vscode.",
    "preview": false,
    "version": "2.3.0",
    "license": "SEE LICENSE IN LICENSE",
    "icon": "Icon.png",
    "engines": {
        "vscode": "^1.144.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "bilibili",
        "bangumi",
        "anime"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "openBangumi",
                "title": "Open Bangumi"
            },
            {
                "command": "nextPage",
                "title": "Bangumi Open: Next Page"
            },
            {
                "command": "backPage",
                "title": "Bangumi Open: Back Page"
            },
            {
                "command": "jumpPage",
                "title": "Bangumi Open: Jump to number of Page"
            },
            {
                "command": "weekBangumi",
                "title": "Bangumi Open: Week Bangumi"
            },
            {
                "command": "index",
                "title": "Bangumi Open: Index"
            }
        ],
        "keybindings": [
            {
                "command": "nextPage",
                "key": "ctrl+alt+l",
                "mac": "cmd+alt+l"
            },
            {
                "command": "backPage",
                "key": "ctrl+alt+k",
                "mac": "cmd+alt+k"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Bangumi Open",
            "properties": {
                "bangumiOpen.DisplayHistory": {
                    "type": "boolean",
                    "default": false,
                    "description": "Whether to show the Bangumi of the past 6 days?"
                },
                "bangumiOpen.EnableReminder": {
                    "type": "boolean",
                    "default": true,
                    "description": "When enabled, BangumiOpen will remind you when the Bangumi is updated."
                },
                "bangumiOpen.ReminderAheadTime": {
                    "type": "integer",
                    "default": 0,
                    "description": "[Unit: seconds] Sometimes, you may need Reminder to remind you in advance."
                },
                "bangumiOpen.DisplayStatusBar": {
                    "type": "boolean",
                    "default": true,
                    "description": "When enabled, StatusBar will shows the next bangumi to be updated."
                },
                "bangumiOpen.DisplayIndexTags": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether to display the tags that have been selected ?"
                }
            }
        }
    },
    "private": true,
    "packageManager": "pnpm@10.34.9",
    "scripts": {
        "build": "vite build",
        "vscode:prepublish": "vite build --minify",
        "watch": "vite build --sourcemap inline --watch",
        "test-compile": "tsc -p ./ --noEmit",
        "pretest": "pnpm test-compile",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/vscode": "~1.144.0",
        "axios": "^1.21.0",
        "oxfmt": "0.75.0",
        "oxlint": "1.90.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    }
}
