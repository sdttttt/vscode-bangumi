{
    "name": "bangumiopen",
    "publisher": "SDTTTTT",
    "author": "SDTTTTT",
    "repository": "https://github.com/sdttttt/vscode-Bangumi",
    "displayName": "Bangumi Open",
    "description": "Support bilibili bangumi for vscode.",
    "preview": false,
    "version": "2.3.0",
    "license": "SEE LICENSE IN LICENSE",
    "icon": "Icon.png",
    "engines": {
        "vscode": "^1.100.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "bilibili",
        "bangumi",
        "anime"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "openBangumi",
                "title": "Open Bangumi"
            },
            {
                "command": "nextPage",
                "title": "Bangumi Open: Next Page"
            },
            {
                "command": "backPage",
                "title": "Bangumi Open: Back Page"
            },
            {
                "command": "jumpPage",
                "title": "Bangumi Open: Jump to number of Page"
            },
            {
                "command": "weekBangumi",
                "title": "Bangumi Open: Week Bangumi"
            },
            {
                "command": "index",
                "title": "Bangumi Open: Index"
            }
        ],
        "keybindings": [
            {
                "command": "nextPage",
                "key": "ctrl+alt+l",
                "mac": "cmd+alt+l"
            },
            {
                "command": "backPage",
                "key": "ctrl+alt+k",
                "mac": "cmd+alt+k"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Bangumi Open",
            "properties": {
                "bangumiOpen.DisplayHistory": {
                    "type": "boolean",
                    "default": false,
                    "description": "Whether to show the Bangumi of the past 6 days?"
                },
                "bangumiOpen.EnableReminder": {
                    "type": "boolean",
                    "default": true,
                    "description": "When enabled, BangumiOpen will remind you when the Bangumi is updated."
                },
                "bangumiOpen.ReminderAheadTime": {
                    "type": "integer",
                    "default": 0,
                    "description": "[Unit: seconds] Sometimes, you may need Reminder to remind you in advance."
                },
                "bangumiOpen.DisplayStatusBar": {
                    "type": "boolean",
                    "default": true,
                    "description": "When enabled, StatusBar will shows the next bangumi to be updated."
                },
                "bangumiOpen.DisplayIndexTags": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether to display the tags that have been selected ?"
                }
            }
        }
    },
    "private": true,
    "packageManager": "pnpm@10.34.9",
    "scripts": {
        "build": "pnpm build:extension && pnpm build:webview",
        "vscode:prepublish": "pnpm build",
        "watch": "pnpm --parallel --stream run \"/^watch:/\"",
        "typecheck": "tsc -p ./ --noEmit && tsc -p webview --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "pretest": "pnpm typecheck",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "build:extension": "vite build",
        "build:webview": "vite build --config vite.webview.mts",
        "watch:extension": "vite build --sourcemap inline --watch",
        "watch:webview": "vite build --config vite.webview.mts --watch",
        "package": "vsce package --no-dependencies",
        "publish:vsce": "vsce publish --no-dependencies",
        "publish:ovsx": "ovsx publish"
    },
    "devDependencies": {
        "@testing-library/preact": "3.2.6",
        "@types/node": "^26.6.6",
        "@types/vscode": "~1.100.0",
        "@types/vscode-webview": "1.57.5",
        "@vitest/coverage-v8": "5.0.5",
        "@vscode/vsce": "4.1.0",
        "happy-dom": "21.0.4",
        "ovsx": "1.3.0",
        "oxfmt": "0.75.0",
        "oxlint": "1.90.0",
        "preact": "11.1.0",
        "typescript": "^7.0.2",
        "unocss": "66.12.0",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@vscode/vsce-sign"
        ]
    }
}
