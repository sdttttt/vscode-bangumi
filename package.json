{
    "name": "bangumiopen",
    "publisher": "SDTTTTT",
    "author": "SDTTTTT",
    "repository": "https://github.com/sdttttt/vscode-Bangumi",
    "displayName": "Bangumi Open",
    "description": "在 VS Code 中查看 B 站番剧时间表与番剧索引。",
    "preview": false,
    "version": "3.0.0",
    "license": "0BSD",
    "icon": "Icon.png",
    "engines": {
        "vscode": "^1.100.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "bilibili",
        "bangumi",
        "anime"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "type": "module",
    "contributes": {
        "commands": [
            {
                "command": "openBangumi",
                "title": "番剧时间表：打开番剧列表"
            },
            {
                "command": "nextPage",
                "title": "番剧时间表：下一页"
            },
            {
                "command": "backPage",
                "title": "番剧时间表：上一页"
            },
            {
                "command": "jumpPage",
                "title": "番剧时间表：跳转到指定页"
            },
            {
                "command": "weekBangumi",
                "title": "番剧时间表：打开周番表"
            },
            {
                "command": "index",
                "title": "番剧时间表：打开筛选索引"
            }
        ],
        "keybindings": [
            {
                "command": "nextPage",
                "key": "ctrl+alt+l",
                "mac": "cmd+alt+l"
            },
            {
                "command": "backPage",
                "key": "ctrl+alt+k",
                "mac": "cmd+alt+k"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Bangumi Open",
            "properties": {
                "bangumiOpen.DisplayHistory": {
                    "type": "boolean",
                    "default": false,
                    "description": "是否显示过去六天的番剧更新。"
                },
                "bangumiOpen.EnableReminder": {
                    "type": "boolean",
                    "default": true,
                    "description": "开启后，番剧更新时会弹出提醒。提醒通知里的「不再提醒」按钮会把它关掉，之后可以在这里重新开启。选择 Bangumi 数据源时不生效，因为该来源没有播出时刻。"
                },
                "bangumiOpen.ReminderAheadTime": {
                    "type": "integer",
                    "default": 0,
                    "description": "提醒提前的时间，单位为秒。"
                },
                "bangumiOpen.DisplayStatusBar": {
                    "type": "boolean",
                    "default": true,
                    "description": "开启后，状态栏会显示下一部即将更新的番剧；选择 Bangumi 数据源时改为显示当日更新的番剧概要。"
                },
                "bangumiOpen.DisplayIndexTags": {
                    "type": "boolean",
                    "default": true,
                    "description": "使用索引时是否显示已经选中的标签。"
                },
                "bangumiOpen.WeekSource": {
                    "type": "string",
                    "enum": [
                        "bilibili",
                        "bangumi"
                    ],
                    "enumDescriptions": [
                        "Bilibili：带播出时刻，支持更新提醒与「显示过去的更新」。",
                        "Bangumi：收录更全、番剧信息更丰富，但没有播出时刻，因此不会提醒。"
                    ],
                    "default": "bilibili",
                    "description": "周番表使用的数据源。Bilibili 收录可能不全；Bangumi（bgm.tv）收录更全，但不提供播出时间，因此无法提醒。"
                }
            }
        }
    },
    "private": true,
    "packageManager": "pnpm@10.34.9",
    "scripts": {
        "build": "pnpm build:extension && pnpm build:webview",
        "vscode:prepublish": "pnpm build",
        "watch": "pnpm --parallel --stream run \"/^watch:/\"",
        "typecheck": "tsc -p ./ --noEmit && tsc -p webview --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "pretest": "pnpm typecheck",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "build:extension": "vite build",
        "build:webview": "vite build --config vite.webview.mts",
        "watch:extension": "vite build --sourcemap inline --watch",
        "watch:webview": "vite build --config vite.webview.mts --watch",
        "package": "vsce package --no-dependencies",
        "publish:vsce": "vsce publish --no-dependencies",
        "publish:ovsx": "ovsx publish"
    },
    "devDependencies": {
        "@testing-library/preact": "3.2.6",
        "@types/node": "^26.6.6",
        "@types/vscode": "~1.100.0",
        "@types/vscode-webview": "1.57.5",
        "@vitest/coverage-v8": "5.0.5",
        "@vscode/vsce": "4.1.0",
        "happy-dom": "21.0.4",
        "ovsx": "1.3.0",
        "oxfmt": "0.75.0",
        "oxlint": "1.90.0",
        "preact": "11.1.0",
        "typescript": "^7.0.2",
        "unocss": "66.12.0",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@vscode/vsce-sign"
        ]
    }
}
