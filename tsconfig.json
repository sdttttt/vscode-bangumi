{
    "compilerOptions": {
        "module": "preserve",
        "moduleResolution": "bundler",
        "target": "ES2022",
        "lib": ["ES2022"],
        "outDir": "out",
        "rootDir": ".",
        "esModuleInterop": true,
        "sourceMap": true,
        "allowJs": true,
        "strict": true,
        "skipLibCheck": true,
        "experimentalDecorators": true,
        "paths": {
            "~/*": ["./*"],
            "@/*": ["./src/*"]
        }
    },
    "exclude": ["node_modules", ".vscode-test", "out", "dist", "coverage"]
}
