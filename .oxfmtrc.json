{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 80,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "jsxSingleQuote": false,
    "bracketSpacing": true,
    "bracketSameLine": true,
    "arrowParens": "avoid",
    "trailingComma": "es5",
    "vueIndentScriptAndStyle": false,
    "sortPackageJson": false,
    "ignorePatterns": [
        "node_modules/",
        "dist/",
        "out/",
        "public/",
        "pnpm-lock.yaml",
        "resources/"
    ]
}
